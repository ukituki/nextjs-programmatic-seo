# Vercel AI SDK Configuration
# ---------------------------
# Add your API key for the desired AI provider.
# For example, to use OpenAI:
# OPENAI_API_KEY="your_openai_api_key_here"

# To use Anthropic:
# ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# To use Google Generative AI:
# GOOGLE_GENERATIVE_AI_API_KEY="your_google_api_key_here"

# (Add other provider examples if you know them, otherwise the above are good starts)


# Active Niche Configuration
# --------------------------
# Determines which niche configuration is loaded by the application.
# This affects the site's content, branding, and available features.
#
# Supported values (examples, actual list may vary based on src/config/niche.*.config.ts files):
# NEXT_PUBLIC_ACTIVE_NICHE=restaurants
# NEXT_PUBLIC_ACTIVE_NICHE=books
# NEXT_PUBLIC_ACTIVE_NICHE=events
NEXT_PUBLIC_ACTIVE_NICHE=doors-windows
